<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="backgroundPane" maxHeight="400.0" maxWidth="550.0" minHeight="400.0" minWidth="550.0" prefHeight="400.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.controller.MainMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <Label id="title" alignment="CENTER" contentDisplay="CENTER" layoutY="90.0" prefHeight="35.0" prefWidth="550.0" text="Snake Game" textAlignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
        <Button fx:id="btn_start" layoutY="170.0" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleStart" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Start" textFill="WHITE" AnchorPane.leftAnchor="217.5" />
        <Button fx:id="btn_settings" layoutY="230.0" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleOpenSettings" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Settings" textFill="WHITE" AnchorPane.leftAnchor="217.5" />

        <StackPane fx:id="difficultyOverlay" visible="false" style="-fx-background-color: rgba(254, 255, 228, 0.98);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" spacing="12.0" maxWidth="520.0">
                    <children>
                        <Label text="SELECT DIFFICULTY" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 26px;" />

                        <VBox alignment="CENTER" spacing="3.0">
                            <children>
                                <Button fx:id="btn_quickMode" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleQuickMode" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Quick" textFill="WHITE" />
                                <Label fx:id="lbl_quickDesc" alignment="CENTER" text="Normal Speed | Borderless Wrap | Growth +1 | 6/8/10 Coins" textAlignment="CENTER" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 12px;" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="3.0">
                            <children>
                                <Button fx:id="btn_classicMode" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleClassicMode" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Classic" textFill="WHITE" />
                                <Label fx:id="lbl_classicDesc" alignment="CENTER" text="Normal Speed | Solid Borders | Growth +1 | 8/10/12 Coins" textAlignment="CENTER" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 12px;" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="3.0">
                            <children>
                                <Button fx:id="btn_hardcoreMode" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleHardcoreMode" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" style="-fx-font-size: 15px;" text="Hardcore" textFill="WHITE" />
                                <Label fx:id="lbl_hardcoreDesc" alignment="CENTER" text="Fast Speed | Solid Borders | Double Growth (+2) | 10/12/14 Coins" textAlignment="CENTER" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 12px;" />
                            </children>
                        </VBox>

                        <Button fx:id="btn_difficultyBack" minHeight="40.0" minWidth="115.0" mnemonicParsing="false" onAction="#handleCloseDifficulty" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="settingsOverlay" visible="false" style="-fx-background-color: rgba(254, 255, 228, 0.96);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" spacing="20.0" maxWidth="320.0">
                    <children>
                        <Label text="SETTINGS" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 32px;" />
                        <Button fx:id="btn_gridToggle" mnemonicParsing="false" onAction="#handleToggleGrid" prefHeight="40.0" prefWidth="140.0" styleClass="startAndQuitBtn" text="Grid: ON" textFill="WHITE" />
                        <Button fx:id="btn_settingsBack" mnemonicParsing="false" onAction="#handleCloseSettings" prefHeight="40.0" prefWidth="115.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
