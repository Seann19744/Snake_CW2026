<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="backgroundPane" maxHeight="400.0" maxWidth="550.0" minHeight="400.0" minWidth="550.0" prefHeight="400.0" prefWidth="550.0" style="-fx-background-color: #feffe4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.controller.MainMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <Canvas fx:id="menuBgCanvas" height="400.0" width="550.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <StackPane mouseTransparent="true" prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="16.0">
            <children>
                <HBox alignment="CENTER" maxHeight="36.0" maxWidth="215.0" spacing="8.0" styleClass="pixel-badge">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@res/goldcoin.png" /></image>
                        </ImageView>
                        <Label fx:id="lbl_highScore" alignment="CENTER" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 14px; -fx-text-fill: #2d572c;" text="BEST SCORE: 0" />
                    </children>
                </HBox>
            </children>
        </StackPane>

        <StackPane translateY="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="285.0" maxWidth="350.0" spacing="20.0" styleClass="pixel-card">
                    <padding>
                        <Insets bottom="22.0" left="25.0" right="25.0" top="22.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label id="title" alignment="CENTER" contentDisplay="CENTER" text="SNAKE GAME" textAlignment="CENTER" />
                                <Label alignment="CENTER" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px; -fx-text-fill: #6e6a50;" text="- PIXEL ARCADE -" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="14.0">
                            <children>
                                <Button fx:id="btn_start" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleStart" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Start" textFill="WHITE" />
                                <Button fx:id="btn_settings" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleOpenSettings" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Settings" textFill="WHITE" />
                                <Button fx:id="btn_quit" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleQuit" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Quit" textFill="WHITE" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>

        <Button fx:id="btn_help" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" mnemonicParsing="false" onAction="#handleOpenHelp" prefHeight="40.0" prefWidth="40.0" style="-fx-background-size: 100% 100%; -fx-font-size: 18px;" styleClass="startAndQuitBtn" text="?" textFill="WHITE" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0" />

        <StackPane fx:id="difficultyOverlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="364.0" maxWidth="514.0" spacing="12.0" styleClass="pixel-card">
                    <padding>
                        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                    </padding>
                    <children>
                        <Label styleClass="pixel-header" text="SELECT DIFFICULTY" />

                        <VBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="pixel-slot">
                                    <children>
                                        <Button fx:id="btn_quickMode" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleQuickMode" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Quick" textFill="WHITE" />
                                        <Label fx:id="lbl_quickDesc" alignment="CENTER_LEFT" maxWidth="315.0" prefWidth="315.0" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px; -fx-line-spacing: 1px; -fx-text-fill: #2b2b2b;" text="Travel at standard speed and pass safely through screen edges. Every coin adds 1 body segment (6, 8, and 10 coins per level)." textAlignment="LEFT" wrapText="true" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="pixel-slot">
                                    <children>
                                        <Button fx:id="btn_classicMode" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleClassicMode" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Classic" textFill="WHITE" />
                                        <Label fx:id="lbl_classicDesc" alignment="CENTER_LEFT" maxWidth="315.0" prefWidth="315.0" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px; -fx-line-spacing: 1px; -fx-text-fill: #2b2b2b;" text="Travel at standard speed within solid, deadly walls. Every coin adds 1 body segment (8, 10, and 12 coins per level)." textAlignment="LEFT" wrapText="true" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="pixel-slot">
                                    <children>
                                        <Button fx:id="btn_hardcoreMode" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleHardcoreMode" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Hardcore" textFill="WHITE" />
                                        <Label fx:id="lbl_hardcoreDesc" alignment="CENTER_LEFT" maxWidth="315.0" prefWidth="315.0" style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px; -fx-line-spacing: 1px; -fx-text-fill: #2b2b2b;" text="Race at high speed within solid, deadly walls. Every coin adds 2 body segments (10, 12, and 14 coins per level)." textAlignment="LEFT" wrapText="true" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Button fx:id="btn_difficultyBack" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleCloseDifficulty" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="settingsOverlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="250.0" maxWidth="330.0" spacing="20.0" styleClass="pixel-card">
                    <padding>
                        <Insets bottom="22.0" left="25.0" right="25.0" top="22.0" />
                    </padding>
                    <children>
                        <Label styleClass="pixel-header" text="SETTINGS" />
                        <Button fx:id="btn_gridToggle" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleToggleGrid" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Grid: ON" textFill="WHITE" />
                        <Button fx:id="btn_settingsBack" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleCloseSettings" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="helpOverlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="368.0" maxWidth="514.0" spacing="8.0" styleClass="pixel-card">
                    <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                    </padding>
                    <children>
                        <Label styleClass="pixel-header" text="HOW TO PLAY" />

                        <VBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="4.0" styleClass="pixel-slot">
                            <children>
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 13px; -fx-text-fill: #2d572c; -fx-underline: true;" text="CONTROLS" />
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="• Arrow Keys: Start moving and steer the snake" wrapText="true" />
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="• ESC: Pause the game and open the pause menu" wrapText="true" />
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="• G: Toggle grid on/off  |  F11: Fullscreen  |  TAB: Restart" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="4.0" styleClass="pixel-slot">
                            <children>
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 13px; -fx-text-fill: #2d572c; -fx-underline: true;" text="COINS &amp; GOAL" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@res/redcoin.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="Red: +5 pts" />
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@res/goldcoin.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="Gold: +15 bonus pts" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@res/rainbowcoin.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="Rainbow: +5 pts &amp; speed boost" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@res/bluecoin.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="Blue: +5 pts &amp; pass through walls" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@res/silvercoin.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 11px;" text="Silver: +5 pts &amp; spawns obstacle blocks" />
                                    </children>
                                </HBox>
                                <Label style="-fx-font-family: 'SF Pixelate'; -fx-font-size: 10px; -fx-text-fill: #4a4a4a;" text="Clear all 3 levels by collecting the target coins without crashing!" wrapText="true" />
                            </children>
                        </VBox>

                        <Button fx:id="btn_helpBack" maxWidth="130.0" minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleCloseHelp" prefHeight="40.0" prefWidth="130.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
